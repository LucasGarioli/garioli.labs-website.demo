{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garioli-labs-website-demo",
  "compatibility_date": "2026-08-25",

  // Worker só de assets: não há `main` nem `binding`, porque não existe código
  // de Worker nenhum — a API desta build roda no navegador (ver src/lib/api-demo.js).
  //
  // Toda rota agora é pré-renderizada: cada página existe como HTML próprio
  // no `build`, nos dois idiomas. Por isso o modo passa a ser `404-page` — o
  // Workers serve o arquivo pedido e, quando ele não existe, devolve o
  // `404.html` com status 404. O modo de SPA devolveria 200 para qualquer
  // endereço inventado, o que ensina o Google a indexar URL que não existe.
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page"
  }
}
