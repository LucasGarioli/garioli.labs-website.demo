{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garioli-labs-demo",
  "compatibility_date": "2026-08-25",

  // Worker só de assets: não há `main` nem `binding`, porque não existe código
  // de Worker nenhum — a API desta build roda no navegador (ver src/lib/api-demo.js).
  //
  // `single-page-application` é obrigatório aqui: o adapter-static emite um
  // único index.html e o roteamento acontece no cliente. Sem isto, abrir
  // /admin ou /proposta direto na barra de endereços devolveria 404 — só a
  // home funcionaria. Com isto, o Workers devolve o index.html com 200 e o
  // roteador do SvelteKit assume, preservando a URL digitada.
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application"
  }
}
